# API Configuration
# These are the default values. You can override them in .env file.

# Translation API - MyMemory Translation Service
# Free tier: 1000 words/day, no API key required
# For higher limits, visit: https://mymemory.translated.net/doc/spec.php
PUBLIC_TRANSLATION_API_URL=https://api.mymemory.translated.net/get

# Dictionary API - Free Dictionary API
# Free tier: No rate limits (fair use policy)
# Documentation: https://dictionaryapi.dev/
PUBLIC_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries

# API Timeout Settings (in milliseconds)
PUBLIC_API_TIMEOUT=10000

# API Retry Settings
PUBLIC_API_RETRY_COUNT=3
PUBLIC_API_RETRY_DELAY=1000
